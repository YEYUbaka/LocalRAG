# LLM 配置 (OpenAI 兼容格式，支持 Qwen/DeepSeek/Moonshot/Ollama 等)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL_NAME=qwen-max

# Embedding 使用本地 bge-small-zh-v1.5 模型（首次需下载到 data/models/）

# RAG 参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
TEMPERATURE=0.7
MAX_TOKENS=2048
CONTEXT_WINDOW=8192  # 模型上下文窗口大小

# 数据目录
DATA_DIR=./data

# MySQL 连接 (SQLAlchemy 格式)
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/localrag
